{
  "name": "sonyia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Transcrição inteligente de áudio e vídeo, multilíngue e com processamento local, sem necessidade de API.",
  "license": "GPL-3.0-or-later",
  "author": "Victor de Brito Brandão",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "build:wasm": "wasm-pack build rust/audio-engine --target web --out-dir ../../src/wasm --out-name audio_engine --release",
    "predev": "npm run assets",
    "dev": "vite",
    "prebuild": "npm run assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test:unit && npm run build && npm run test:e2e",
    "verify": "npm run test:all"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@huggingface/transformers": "4.3.2",
    "franc": "6.2.0",
    "jspdf": "4.2.1"
  },
  "devDependencies": {
    "@ffmpeg/core": "0.12.10",
    "@playwright/test": "1.65.1",
    "happy-dom": "21.0.4",
    "onnxruntime-web": "1.31.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
